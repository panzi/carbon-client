{
  "name": "@panzi/carbon-client",
  "version": "1.4.1",
  "description": "Simple Graphite Carbon client for ingesting metrics in TypeScript for NodeJS.",
  "main": "./build/cjs/index.js",
  "types": "./build/cjs/index.d.ts",
  "type": "module",
  "scripts": {
    "test": "jest --detectOpenHandles --forceExit",
    "clean": "rm -rf build",
    "build": "npm run build:types && npm run build:cjs && npm run build:esm",
    "build:clean": "npm run clean && npm run build",
    "build:types": "npx tsc --outDir build/types --declaration --emitDeclarationOnly",
    "build:cjs": "npx tsc --module commonjs --outDir build/cjs --declaration",
    "build:esm": "npx tsc --module es2022 --outDir build/esm",
    "build:doc": "typedoc src/index.ts",
    "mkcerts": "./test/mkcerts.sh"
  },
  "keywords": [
    "graphite",
    "carbon",
    "carbon-cache",
    "metrics"
  ],
  "author": "Mathias Panzenböck",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panzi/carbon-client.git"
  },
  "bugs": {
    "url": "https://github.com/panzi/carbon-client/issues"
  },
  "homepage": "https://github.com/panzi/carbon-client#readme",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.0",
    "jest": "^30.5.2",
    "mockdate": "^3.0.5",
    "ts-jest": "^29.4.14",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3"
  }
}
